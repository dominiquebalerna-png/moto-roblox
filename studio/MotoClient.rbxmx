<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4">
	<Item class="LocalScript" referent="RBXMotoClient">
		<Properties>
			<string name="Name">MotoClient</string>
			<ProtectedString name="Source"><![CDATA[-- MotoClient (LocalScript)
-- Dove va: StarterPlayer > StarterPlayerScripts
-- Guida della moto (versione base, senza impennata):
--   W = gas, S = freno, A / D = sterzo, E = scendi (anche Spazio).
--   S in velocita' = sgommata (ruota dietro bloccata, riga nera e fumo);
--   W + S da fermo = burnout (con A / D giri sul posto).
--   SHIFT = colpo di frizione che stacca la ruota davanti; poi l'impennata si tiene con W (su) e S (giu').
--   Oltre 100 gradi cadi all'indietro (ragdoll), la moto vola via; poi E per risalire.
-- Camera: segue la moto in curva; la puoi girare col mouse, dopo 1,5 s che non la tocchi torna dietro.
-- Muove anche le parti di TUTTE le moto: ruote che girano, manubrio che sterza,
-- forcella e forcellone che ammortizzano, piega in curva.
-- Mette i piloti in posa (ReplicatedStorage > PosaPilota): mani sulle manopole, piedi sulle pedane,
-- e il corpo si muove: indietro quando accelera, avanti quando frena, dentro le curve, molleggia.
-- Nell'Output le righe di questo script iniziano con [Moto].

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local VERSIONE = 8
local giocatore = Players.LocalPlayer
local cartella = Workspace:WaitForChild("Moto")
local eventoScendi = ReplicatedStorage:WaitForChild("MotoScendi")
local eventoSgomma = ReplicatedStorage:WaitForChild("MotoSgomma")
local eventoCaduta = ReplicatedStorage:WaitForChild("MotoCaduta")
local TweenService = game:GetService("TweenService")
local Posa = require(ReplicatedStorage:WaitForChild("PosaPilota"))

-- geometria (uguale al MotoServer), in stud, per la moto a scala 1.
-- Ogni moto ha l'attributo "Scala" (messo dal server): le misure vere sono queste x Scala.
local PASSO = 5.1536 -- distanza tra le ruote
local R_DIETRO = 1.19 -- raggio gomma dietro
local R_DAVANTI = 1.23 -- raggio gomma davanti
local TELAIO_ASSE = CFrame.new(0, -0.9, 2.6) -- dal centro del Telaio all'asse dietro

-- guida
local VEL_MAX = 95 -- stud/s (circa 95 km/h)
local ACCEL = 30
local FRENATA = 55
local ATTRITO = 3
local STERZO_MAX = math.rad(32) -- angolo di sterzo da fermo
local PIEGA_MAX = math.rad(60) -- piega massima in curva

local NOMI_GIUNTI = { "Sterzo", "Forcella", "RuotaDavanti", "Forcellone", "RuotaDietro" }

-- impennata (angoli in radianti), provata con una simulazione:
-- SHIFT da solo la stacca di ~15 gradi, SHIFT + W arriva a ~80 gradi in un secondo,
-- tenendo W il codino tocca terra e dopo qualche secondo si va oltre 100 gradi.
local IMP = {
	colpo = 3.0, -- spinta del colpo di frizione (rad/s)
	equilibrio = math.rad(72), -- punto di equilibrio (baricentro sopra la ruota)
	gravita = 8, -- quanto la moto vuole tornare giu'
	gas = 9, -- quanto il gas la alza (cala salendo)
	freno = 14, -- quanto il freno dietro la riporta giu'
	smorza = 2.2,
	codino = math.rad(70.9), -- a questo angolo il codino tocca terra
	molla = 7, -- quanto il codino a terra frena la salita
	caduta = math.rad(100),
	piegaCodino = math.rad(22), -- quanto si piega al massimo il codino
}

-- ---------------------------------------------------------------- parti mobili (tutte le moto)

local stati = {} -- [moto] = stato grafico
local guida = nil -- stato della guida quando sono in sella (lo usano anche grafica e posa)

local function statoDi(moto)
	local st = stati[moto]
	if st then
		return st
	end
	local g = {}
	for _, nome in ipairs(NOMI_GIUNTI) do
		local j = moto:FindFirstChild("Giunto_" .. nome, true)
		if not (j and j:IsA("Motor6D")) then
			return nil -- la moto non e' ancora arrivata tutta
		end
		g[nome] = j
	end
	-- il codino mobile c'e' solo nel modello nuovo (se manca va bene lo stesso)
	local jc = moto:FindFirstChild("Giunto_Codino", true)
	g.Codino = (jc and jc:IsA("Motor6D")) and jc or nil
	local telaio = moto:FindFirstChild("Telaio")
	if not telaio then
		return nil
	end
	st = {
		giunti = g,
		telaio = telaio,
		scala = moto:GetAttribute("Scala") or 1,
		giroDietro = 0,
		giroDavanti = 0,
		sterzo = 0,
		forc = 0.12, forcVel = 0, -- forcella: affondamento (stud)
		amm = 0.05, ammVel = 0, -- forcellone: affondamento (stud)
		velPrima = Vector3.zero,
		longit = 0, -- accelerazione in avanti, filtrata
		corpo = 0, corpoVel = 0, -- oscillazione avanti/indietro del pilota
		salto = 0, saltoVel = 0, -- molleggio su/giu' del pilota
	}
	stati[moto] = st
	print(string.format("[Moto] Client v%d: parti mobili collegate su %s (giunti: 5 su 5)", VERSIONE, moto.Name))
	return st
end

cartella.ChildRemoved:Connect(function(moto)
	stati[moto] = nil
end)

-- molla semplice: x va verso "obiettivo", con rimbalzo smorzato
local function molla(x, v, obiettivo, dt, k, c)
	local a = k * (obiettivo - x) - c * v
	v += a * dt
	x += v * dt
	return x, v
end

-- ---------------------------------------------------------------- sgommate: fumo e righe nere

local cartellaSegni = Instance.new("Folder")
cartellaSegni.Name = "SegniGomme" -- solo su questo computer
cartellaSegni.Parent = Workspace
local SEGNI_MAX = 400
local segni = {}

local function filtroSegni()
	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	local escludi = { cartella, cartellaSegni }
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then
			table.insert(escludi, pl.Character)
		end
	end
	p.FilterDescendantsInstances = escludi
	return p
end

local function nuovoSegno(a, b, normale, larghezza)
	local lung = (b - a).Magnitude
	if lung < 0.05 then
		return
	end
	local s = Instance.new("Part")
	s.Name = "Segno"
	s.Anchored = true
	s.CanCollide = false
	s.CanQuery = false
	s.CanTouch = false
	s.CastShadow = false
	s.Material = Enum.Material.SmoothPlastic
	s.Color = Color3.fromRGB(18, 18, 18)
	s.Transparency = 0.3
	s.Size = Vector3.new(larghezza, 0.04, lung + 0.1)
	s.CFrame = CFrame.lookAt((a + b) / 2, b, normale)
	s.Parent = cartellaSegni
	table.insert(segni, s)
	if #segni > SEGNI_MAX then
		local vecchio = table.remove(segni, 1)
		vecchio:Destroy()
	end
	task.delay(8, function()
		if s.Parent then
			local t = TweenService:Create(s, TweenInfo.new(4), { Transparency = 1 })
			t:Play()
			t.Completed:Wait()
			s:Destroy()
		end
	end)
end

local function effettiSgomma(moto, st, sg)
	local perno = moto:FindFirstChild("Perno_Forcellone")
	if not perno then
		return
	end
	local k = st.scala
	if not st.fumo then
		-- punto in cui la gomma dietro tocca terra (nel sistema del forcellone)
		local att = Instance.new("Attachment")
		att.Name = "Fumo"
		att.Position = Vector3.new(0, (-0.4283 - 1.15) * k, 2.0347 * k)
		att.Parent = perno
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "FumoGomma"
		pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
		pe.Color = ColorSequence.new(Color3.fromRGB(240, 240, 240), Color3.fromRGB(205, 205, 205))
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2 * k), NumberSequenceKeypoint.new(1, 7 * k) })
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1) })
		pe.Lifetime = NumberRange.new(1.5, 3)
		pe.Speed = NumberRange.new(3, 7)
		pe.SpreadAngle = Vector2.new(40, 40)
		pe.EmissionDirection = Enum.NormalId.Back
		pe.Acceleration = Vector3.new(0, 2.5, 0)
		pe.Drag = 1.5
		pe.Rotation = NumberRange.new(0, 360)
		pe.RotSpeed = NumberRange.new(-40, 40)
		pe.Enabled = false
		pe.Parent = att
		st.fumo, st.attFumo = pe, att
	end
	st.fumo.Enabled = sg > 0
	st.fumo.Rate = sg == 2 and 70 or 30
	if sg == 0 then
		st.ultimoSegno = nil
		return
	end
	-- riga nera sull'asfalto
	local p = st.attFumo.WorldPosition
	local colpo = Workspace:Raycast(p + Vector3.new(0, 1, 0), Vector3.new(0, -3, 0), filtroSegni())
	if not colpo then
		st.ultimoSegno = nil
		return
	end
	local punto = colpo.Position + colpo.Normal * 0.02
	local larghezza = 0.32 * k
	if not st.ultimoSegno then
		st.ultimoSegno, st.tempoSegno = punto, os.clock()
	elseif (punto - st.ultimoSegno).Magnitude > 0.35 then
		nuovoSegno(st.ultimoSegno, punto, colpo.Normal, larghezza)
		st.ultimoSegno, st.tempoSegno = punto, os.clock()
	elseif sg == 2 and os.clock() - st.tempoSegno > 0.35 then
		-- burnout fermo: macchia nera sotto la ruota
		local dietro = st.telaio.CFrame.LookVector * -0.3
		nuovoSegno(punto - dietro, punto + dietro, colpo.Normal, larghezza * 1.2)
		st.tempoSegno = os.clock()
	end
end

local function scintilleCodino(moto, st, accese)
	if not st.scintille then
		local perno = moto:FindFirstChild("Perno_Codino")
		if not perno then
			return
		end
		local k = st.scala
		-- punta del codino: nel modello e' a z = +1,15 e y = +2,13 dall'asse dietro,
		-- il perno del codino e' a z = -0,67 e y = +2,09
		local att = Instance.new("Attachment")
		att.Name = "PuntaCodino"
		att.Position = Vector3.new(0, 0.04 * k, 1.82 * k)
		att.Parent = perno
		local pe = Instance.new("ParticleEmitter")
		pe.Name = "Scintille"
		pe.LightEmission = 1
		pe.Color = ColorSequence.new(Color3.fromRGB(255, 220, 120), Color3.fromRGB(255, 110, 20))
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.18), NumberSequenceKeypoint.new(1, 0) })
		pe.Lifetime = NumberRange.new(0.15, 0.4)
		pe.Speed = NumberRange.new(10, 22)
		pe.SpreadAngle = Vector2.new(25, 25)
		pe.EmissionDirection = Enum.NormalId.Back
		pe.Acceleration = Vector3.new(0, -60, 0)
		pe.Rate = 140
		pe.Enabled = false
		pe.Parent = att
		st.scintille = pe
	end
	st.scintille.Enabled = accese
end

local function aggiornaGrafica(moto, st, dt, mia)
	local tel = st.telaio
	local cf = tel.CFrame
	local vel = tel.AssemblyLinearVelocity
	local velAvanti = vel:Dot(cf.LookVector)
	local accel = (vel - st.velPrima) / math.max(dt, 1 / 240)
	st.velPrima = vel

	-- ruote: giro = distanza / raggio (angolo negativo = rotola in avanti)
	local k = st.scala
	-- sgommata: 1 = ruota dietro bloccata (non gira), 2 = burnout (gira fortissimo)
	local sg = mia and mia.sgomma or (moto:GetAttribute("Sgomma") or 0)
	if sg == 2 then
		st.giroDietro -= 45 * dt
	elseif sg == 0 then
		st.giroDietro -= velAvanti / (R_DIETRO * k) * dt
	end
	effettiSgomma(moto, st, sg)
	st.giroDavanti -= velAvanti / (R_DAVANTI * k) * dt

	-- sterzo: per la mia moto uso il comando, per le altre lo stimo dalla rotazione
	local sterzo
	if mia then
		sterzo = mia.angoloSterzo
	else
		local yaw = tel.AssemblyAngularVelocity:Dot(cf.UpVector)
		sterzo = math.atan(yaw * PASSO * k / math.max(math.abs(velAvanti), 2)) * math.sign(velAvanti + 0.01)
		sterzo = math.clamp(sterzo, -STERZO_MAX, STERZO_MAX)
	end
	st.sterzo += (sterzo - st.sterzo) * math.min(1, dt * 12)

	-- sospensioni: frenando affonda davanti, accelerando si siede dietro, i colpi verticali le comprimono
	local longit = accel:Dot(cf.LookVector) -- + accelera, - frena
	local vert = accel:Dot(cf.UpVector)
	st.longit += (math.clamp(longit, -80, 80) - st.longit) * math.min(1, dt * 8)
	-- il corpo del pilota ha inerzia: quando acceleri resta indietro, quando freni va avanti
	st.corpo, st.corpoVel = molla(st.corpo, st.corpoVel, math.clamp(st.longit / 60, -1, 1), dt, 60, 9)
	st.salto, st.saltoVel = molla(st.salto, st.saltoVel, math.clamp(-vert / 400, -0.12, 0.12), dt, 90, 8)
	-- piu' marcate, come nel gioco di riferimento: in frenata la forcella affonda tanto,
	-- col gas il dietro si schiaccia e il davanti si alza
	local obForc = math.clamp(0.14 - longit * 0.009 + vert * 0.003, 0, 0.8)
	local obAmm = math.clamp(0.06 + longit * 0.005 + vert * 0.003, 0, 0.45)
	-- impennata: per la mia moto la so, per le altre la stimo dall'inclinazione
	local imp = mia and mia.theta or math.max(0, math.asin(math.clamp(cf.LookVector.Y, -1, 1)) - 0.06)
	st.theta = imp
	if imp > 0.05 then
		obForc = 0 -- ruota davanti in aria: forcella tutta allungata
		obAmm = 0.22 -- il dietro e' schiacciato
	end
	if mia and not mia.aTerra then
		obForc, obAmm = 0, 0 -- in aria le sospensioni si allungano
	end
	if mia and mia.colpoForcella then
		-- la ruota davanti e' appena atterrata: botta sulla forcella
		st.forcVel += mia.colpoForcella
		mia.colpoForcella = nil
	end
	st.forc, st.forcVel = molla(st.forc, st.forcVel, obForc, dt, 180, 14)
	st.amm, st.ammVel = molla(st.amm, st.ammVel, obAmm, dt, 160, 13)
	st.forc = math.clamp(st.forc, 0, 0.8)
	st.amm = math.clamp(st.amm, 0, 0.5)

	local g = st.giunti
	g.RuotaDietro.Transform = CFrame.Angles(st.giroDietro, 0, 0)
	g.RuotaDavanti.Transform = CFrame.Angles(st.giroDavanti, 0, 0)
	g.Sterzo.Transform = CFrame.Angles(0, st.sterzo, 0)
	g.Forcella.Transform = CFrame.new(0, st.forc, 0)
	-- forcellone lungo 2,08 stud (x scala): alzare la ruota di "amm" = ruotarlo di amm/lunghezza
	g.Forcellone.Transform = CFrame.Angles(-st.amm / (2.08 * k), 0, 0)
	-- codino: quando in impennata tocca terra si piega verso l'alto
	local piegaCodino = math.clamp(imp - IMP.codino, 0, IMP.piegaCodino)
	st.piegaCodino = (st.piegaCodino or 0) + (piegaCodino - (st.piegaCodino or 0)) * math.min(1, dt * 20)
	if g.Codino then
		g.Codino.Transform = CFrame.Angles(-st.piegaCodino, 0, 0)
	end
	scintilleCodino(moto, st, st.piegaCodino > 0.01 and math.abs(velAvanti) > 4)
end

-- ---------------------------------------------------------------- posa dei piloti

local piloti = {} -- [personaggio] = { giunti, transform, ... }
local animatiFermati = {} -- personaggi a cui ho spento le animazioni (solo il mio)

local function giuntiPilota(char)
	local p = piloti[char]
	if p then
		local valido = p.g.Root and p.g.Root.inst.Parent and p.g.Root.Part1.Parent == char
		if valido then
			Posa.aggiorna(p.g)
			return p
		end
		if p.rotto and p.riprova and os.clock() < p.riprova then
			return p
		end
	end
	local g, ok, trovati, mancanti = Posa.trovaGiunti(char)
	if not ok then
		if not (p and p.avvisato) then
			warn(string.format("[Moto] Posa del pilota NON possibile per %s: trovate %d articolazioni su 15, mancano: %s. Giunti nel personaggio: %s",
				char.Name, trovati, table.concat(mancanti, ", "), Posa.ultimiTipi))
		end
		-- riprovo tra 2 secondi (il personaggio potrebbe essere ancora in caricamento)
		piloti[char] = { g = g, rotto = true, avvisato = true, riprova = os.clock() + 2 }
		return piloti[char]
	end
	p = { g = g, transform = {}, inizio = os.clock(), controllato = false }
	piloti[char] = p
	print(string.format("[Moto] Posa del pilota attiva per %s (articolazioni trovate: %d su 15%s). Giunti nel personaggio: %s",
		char.Name, trovati, #mancanti > 0 and (", mancano: " .. table.concat(mancanti, ", ")) or "", Posa.ultimiTipi))
	return p
end

local function fermaAnimazioni(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	local animate = char:FindFirstChild("Animate")
	if animate and animate:IsA("LocalScript") then
		animate.Enabled = false
	end
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if animator then
		for _, traccia in ipairs(animator:GetPlayingAnimationTracks()) do
			traccia:Stop(0)
		end
	end
	animatiFermati[char] = true
end

local function liberaPilota(char)
	local p = piloti[char]
	if p and p.g then
		for chiave in pairs(Posa.PARTI) do
			local j = p.g[chiave]
			if j and j.inst.Parent then
				j.inst.Transform = CFrame.new()
			end
		end
	end
	piloti[char] = nil
	if animatiFermati[char] then
		animatiFermati[char] = nil
		local animate = char:FindFirstChild("Animate")
		if animate and animate:IsA("LocalScript") then
			animate.Enabled = true
		end
	end
end

local function controllaPosa(char, p, info)
	-- dopo 1,5 secondi controllo DOVE sono davvero mani e piedi (cosi' sappiamo se la posa si vede)
	p.controllato = true
	local mano = char:FindFirstChild("RightHand")
	local presa = mano and mano:FindFirstChild("RightGripAttachment")
	if not (mano and info.manD) then
		return
	end
	local puntoMano = presa and presa.WorldPosition or mano.Position
	local dMano = (puntoMano - info.manD).Magnitude
	local piede = char:FindFirstChild("RightFoot")
	local dPiede = piede and (piede.Position - info.caviglia).Magnitude or -1
	local busto = char:FindFirstChild("UpperTorso")
	local dBusto = (busto and info.cfBusto) and (busto.Position - info.cfBusto.Position).Magnitude or -1
	print(string.format("[Moto] Controllo posa %s: mano destra a %.2f stud dalla manopola, piede destro a %.2f dalla pedana, busto a %.2f dal previsto (vicino a 0 = giusto)",
		char.Name, dMano, dPiede, dBusto))
	if dMano > 0.6 then
		local hum = char:FindFirstChildOfClass("Humanoid")
		local animator = hum and hum:FindFirstChildOfClass("Animator")
		local nomi = {}
		if animator then
			for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
				table.insert(nomi, t.Name)
			end
		end
		warn("[Moto] La posa NON si vede: qualcosa la sovrascrive. Animazioni in corso: "
			.. (#nomi > 0 and table.concat(nomi, ", ") or "nessuna"))
	end
end

local function posaPilota(moto, st, dt)
	local sella = moto:FindFirstChild("Sella")
	local hum = sella and sella.Occupant
	local char = hum and hum.Parent
	if not char then
		return nil
	end
	local p = giuntiPilota(char)
	if p.rotto then
		return char
	end
	if char == giocatore.Character and not animatiFermati[char] then
		fermaAnimazioni(char)
	end
	local perno = moto:FindFirstChild("Perno_Corpo")
	if not perno then
		return char
	end
	local cfMoto = perno.CFrame
	local c0 = st.giunti.Sterzo.C0
	local cfSterzo = cfMoto * c0 * CFrame.Angles(0, st.sterzo, 0) * c0:Inverse()
	-- piccoli movimenti di equilibrio + piega del corpo dentro la curva
	local t = os.clock()
	local piegaMoto = math.asin(math.clamp(cfMoto.RightVector.Y, -1, 1))
	-- in impennata (come nel video vero) scivola in fondo alla sella e porta il busto in avanti
	-- rispetto alla moto, cosi' resta quasi dritto rispetto alla strada, braccia tese
	local imp = st.theta or 0
	local mia = guida and guida.moto == moto and guida or nil
	local gasVis = mia and mia.gasVis or (st.longit > 4 and 1 or 0)
	local dyn = {
		busto = -st.corpo * math.rad(7) + math.rad(1.2) * math.sin(t * 1.7) + imp * 0.6,
		scivola = st.corpo * 0.12 + math.min(imp, 1.2) * 0.3,
		rollio = piegaMoto * 0.25 + math.rad(0.8) * math.sin(t * 1.3),
		molleggio = st.salto - (st.amm - 0.05) * 0.4,
		gas = gasVis,
	}
	local ok, trasf, info = pcall(Posa.calcola, p.g, cfMoto, cfSterzo, dyn, st.scala)
	if not ok then
		if not p.erroreStampato then
			p.erroreStampato = true
			warn("[Moto] Errore nel calcolo della posa: " .. tostring(trasf))
		end
		return char
	end
	p.transform = trasf
	for j, tr in pairs(trasf) do
		j.inst.Transform = tr
	end
	if not p.controllato and os.clock() - p.inizio > 1.5 then
		controllaPosa(char, p, info)
	end
	return char
end

-- le animazioni di Roblox scrivono i giunti DOPO il RenderStepped: riscrivo la posa anche dopo di loro
RunService.Stepped:Connect(function()
	for char, p in pairs(piloti) do
		if p.transform then
			for j, tr in pairs(p.transform) do
				if j.inst.Parent then
					j.inst.Transform = tr
				end
			end
		end
	end
end)

-- ---------------------------------------------------------------- guida (solo la mia moto)


local function tasto(...)
	for _, k in ipairs({ ... }) do
		if UserInputService:IsKeyDown(k) then
			return true
		end
	end
	return false
end

local function parametriRaggi(moto)
	local p = RaycastParams.new()
	p.FilterType = Enum.RaycastFilterType.Exclude
	local escludi = { cartella }
	for _, pl in ipairs(Players:GetPlayers()) do
		if pl.Character then
			table.insert(escludi, pl.Character)
		end
	end
	p.FilterDescendantsInstances = escludi
	return p
end

local function iniziaGuida(moto)
	local tel = moto:WaitForChild("Telaio")
	local look = tel.CFrame.LookVector
	guida = {
		moto = moto,
		telaio = tel,
		orient = tel:WaitForChild("Orientamento"),
		vel = 0,
		yaw = math.atan2(-look.X, -look.Z),
		beccheggio = 0,
		piega = 0,
		sterzoIn = 0,
		angoloSterzo = 0,
		aTerra = true,
		sgomma = 0,
		theta = 0, -- impennata (rad)
		omega = 0,
		colpo = false,
		gasVis = 0,
		piegaImp = 0,
		raggi = parametriRaggi(moto),
		scala = moto:GetAttribute("Scala") or 1,
		tempoRaggi = 0,
	}
	print("[Moto] Sei in sella a " .. moto.Name .. ". W gas, S freno, A/D sterzo, SHIFT impennata, E scendi.")
end

local function fineGuida()
	if guida then
		print("[Moto] Sei sceso dalla moto")
	end
	guida = nil
	local cam = Workspace.CurrentCamera
	if cam then
		cam.FieldOfView = 70
	end
end

-- caduta all'indietro: il server stacca il pilota e lancia la moto, qui faccio il ragdoll
local function cadi()
	local g = guida
	if not g or g.caduto then
		return
	end
	g.caduto = true
	local velMoto = g.telaio.AssemblyLinearVelocity
	local avanti = g.telaio.CFrame.LookVector
	print(string.format("[Moto] Caduta! Impennata oltre %d gradi", math.deg(IMP.caduta)))
	eventoCaduta:FireServer()
	local char = giocatore.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local sella = g.moto:FindFirstChild("Sella")
	local w = sella and sella:FindFirstChild("SeatWeld")
	if w then
		w:Destroy()
	end
	fineGuida()
	if not (char and hum) then
		return
	end
	-- ragdoll: spengo i giunti animati, restano le articolazioni "a sfera" (BallSocket)
	local spenti = {}
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("AnimationConstraint") and d.Enabled then
			d.Enabled = false
			table.insert(spenti, d)
		end
	end
	hum:ChangeState(Enum.HumanoidStateType.Physics)
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.AssemblyLinearVelocity = velMoto * 0.6 - avanti * 12 + Vector3.new(0, 18, 0)
		hrp.AssemblyAngularVelocity = hrp.CFrame.RightVector * 6
	end
	print(string.format("[Moto] Ragdoll attivo (%d articolazioni sciolte). Ti rialzi tra 2,5 secondi.", #spenti))
	task.delay(2.5, function()
		for _, d in ipairs(spenti) do
			if d.Parent then
				d.Enabled = true
			end
		end
		if hum.Parent and hum.Health > 0 then
			hum:ChangeState(Enum.HumanoidStateType.GettingUp)
		end
		print("[Moto] Ti sei rialzato: vai alla moto e premi E per risalire")
	end)
end

local function guidaPasso(dt)
	local g = guida
	local tel = g.telaio
	if tel.Anchored then
		return -- il server non mi ha ancora dato la moto
	end

	-- comandi
	local gas = tasto(Enum.KeyCode.W, Enum.KeyCode.Up) and 1 or 0
	local freno = tasto(Enum.KeyCode.S, Enum.KeyCode.Down) and 1 or 0
	local dx = tasto(Enum.KeyCode.D, Enum.KeyCode.Right) and 1 or 0
	local sx = tasto(Enum.KeyCode.A, Enum.KeyCode.Left) and 1 or 0
	g.sterzoIn += ((dx - sx) - g.sterzoIn) * math.min(1, dt * 6)
	g.gasVis += (gas - g.gasVis) * math.min(1, dt * 12) -- la mano destra gira la manopola del gas

	-- velocita'
	-- W + S quasi fermo = burnout: la moto resta li' e la ruota dietro gira
	local burnout = gas > 0 and freno > 0 and math.abs(g.vel) < 8
	local v = g.vel
	if burnout then
		v -= math.sign(v) * math.min(math.abs(v), 30 * dt)
	elseif gas > 0 then
		v += ACCEL * (1 - math.clamp(v / VEL_MAX, 0, 1)) * dt
	end
	if freno > 0 and not burnout then
		if v > 0.5 then
			v -= FRENATA * dt
		else
			v = math.max(v - 8 * dt, -5) -- da fermo con S va piano all'indietro
		end
	end
	v -= math.sign(v) * math.min(math.abs(v), (ATTRITO + 0.004 * v * v) * dt)
	-- se sbatto contro un muro la velocita' vera e' piu' bassa: mi adeguo
	local velVera = tel.AssemblyLinearVelocity
	local avantiPiatto = Vector3.new(-math.sin(g.yaw), 0, -math.cos(g.yaw))
	local vVera = velVera:Dot(avantiPiatto)
	if v > 0 and vVera < v - 12 then
		v = math.max(vVera + 12, 0)
	end
	g.vel = v

	-- terreno: un raggio sotto ogni ruota
	local k = g.scala
	local passo, rDietro = PASSO * k, R_DIETRO * k
	local asse = tel.CFrame * CFrame.new(TELAIO_ASSE.Position * k)
	local pDietro = asse.Position
	local pDavanti = pDietro + avantiPiatto * passo
	local giu = Vector3.new(0, -(rDietro + 3), 0)
	local su = Vector3.new(0, 1.5, 0)
	local cDietro = Workspace:Raycast(pDietro + su, giu - su, g.raggi)
	local cDavanti = Workspace:Raycast(pDavanti + su, giu - su, g.raggi)
	local aTerra = cDietro ~= nil and (pDietro.Y - cDietro.Position.Y) < rDietro + 0.6

	-- sgommata in frenata: S senza gas a piu' di 10 stud/s, a terra
	local strisciata = not burnout and freno > 0 and gas == 0 and v > 10 and aTerra and g.theta < 0.05
	local stato = (burnout and aTerra) and 2 or (strisciata and 1 or 0)
	if stato ~= g.sgomma then
		g.sgomma = stato
		eventoSgomma:FireServer(stato)
	end

	-- sterzo e piega (solo a terra)
	local sterzoMax = STERZO_MAX / (1 + math.abs(v) / 30)
	g.angoloSterzo = -g.sterzoIn * sterzoMax
	local yawRate = 0
	if aTerra then
		if stato == 2 then
			-- burnout: con A / D la ruota dietro gira attorno a quella davanti ("donut")
			yawRate = -g.sterzoIn * 1.9
			g.angoloSterzo = -g.sterzoIn * STERZO_MAX
		else
			yawRate = v * math.tan(g.angoloSterzo) / passo
			if g.theta > 0.05 then
				yawRate *= 0.35 -- in impennata si gira poco (ruota davanti in aria)
			end
			if stato == 1 then
				-- ruota dietro bloccata: il dietro scappa un po' e scodinzola
				yawRate = yawRate * 1.5 + math.sin(os.clock() * 9) * 0.12
			end
		end
	end
	g.yaw += yawRate * dt
	local gravita = Workspace.Gravity
	local piegaOb
	if not aTerra then
		piegaOb = g.piega * 0.98
	elseif stato == 2 then
		piegaOb = yawRate * 0.12
	else
		piegaOb = math.clamp(math.atan(v * yawRate / gravita) * 1.25, -PIEGA_MAX, PIEGA_MAX)
	end
	g.piega += (piegaOb - g.piega) * math.min(1, dt * 5)

	-- beccheggio dal terreno
	-- impennata: pendolo rovesciato attorno alla ruota dietro
	if g.colpo then
		g.colpo = false
		if aTerra and g.theta < 0.05 and v > 2 then
			g.omega += IMP.colpo
		end
	end
	if aTerra and (g.theta > 0 or g.omega > 0) then
		local th = g.theta
		local a = -IMP.gravita * math.sin(IMP.equilibrio - th)
			+ gas * IMP.gas * math.max(0, 1 - th / 1.6)
			- freno * IMP.freno
			- IMP.smorza * g.omega
		if th > IMP.codino then
			a -= (th - IMP.codino) * IMP.molla + (g.omega > 0 and 2 * g.omega or 0)
		end
		g.omega += a * dt
		g.theta += g.omega * dt
		if g.theta <= 0 then
			if g.omega < -1 then
				g.colpoForcella = math.min(-g.omega * 1.4, 6) -- atterraggio della ruota davanti
			end
			g.theta, g.omega = 0, 0
		end
		if g.theta > IMP.caduta then
			cadi()
			return
		end
	end
	-- un po' di equilibrio laterale in impennata
	g.piegaImp = g.theta > 0.1 and math.sin(os.clock() * 2.3) * math.rad(2.5) * math.min(g.theta, 1) or 0

	if aTerra and cDavanti and g.theta < 0.05 then
		local ob = math.atan2(cDavanti.Position.Y - cDietro.Position.Y, passo)
		g.beccheggio += (ob - g.beccheggio) * math.min(1, dt * 12)
	end

	-- velocita' da dare al telaio
	local vy = velVera.Y
	if aTerra then
		local yOb = cDietro.Position.Y + rDietro * math.cos(g.piega)
		vy = math.clamp((yOb - pDietro.Y) * 18, -40, 60) + v * math.sin(g.beccheggio)
	end
	local orizz = avantiPiatto * v * math.cos(g.beccheggio)
	if stato == 2 then
		-- nel burnout il dietro gira attorno alla ruota davanti
		orizz = Vector3.new(0, yawRate, 0):Cross(pDietro - pDavanti)
	end
	tel.AssemblyLinearVelocity = Vector3.new(orizz.X, vy, orizz.Z)

	-- orientamento: direzione, beccheggio, piega
	g.orient.CFrame = CFrame.Angles(0, g.yaw, 0) * CFrame.Angles(g.beccheggio + g.theta, 0, 0) * CFrame.Angles(0, 0, g.piega + g.piegaImp)
	g.aTerra = aTerra

	-- campo visivo che si allarga con la velocita'
	local cam = Workspace.CurrentCamera
	if cam then
		local fov = 70 + math.clamp(math.abs(v), 0, VEL_MAX) * 0.22
		cam.FieldOfView += (fov - cam.FieldOfView) * math.min(1, dt * 4)
	end
end

-- ---------------------------------------------------------------- salire / scendere

local function collegaPersonaggio(char)
	local hum = char:WaitForChild("Humanoid")
	hum.Seated:Connect(function(seduto, sedile)
		if seduto and sedile and sedile.Name == "Sella" and sedile:IsDescendantOf(cartella) then
			iniziaGuida(sedile.Parent)
		else
			fineGuida()
		end
	end)
	hum.Died:Connect(fineGuida)
end

if giocatore.Character then
	task.spawn(collegaPersonaggio, giocatore.Character)
end
giocatore.CharacterAdded:Connect(collegaPersonaggio)

UserInputService.InputBegan:Connect(function(input, giaUsato)
	if giaUsato then
		return
	end
	if input.KeyCode == Enum.KeyCode.E and guida then
		eventoScendi:FireServer()
	end
	if (input.KeyCode == Enum.KeyCode.LeftShift or input.KeyCode == Enum.KeyCode.RightShift) and guida then
		guida.colpo = true -- colpo di frizione: stacca la ruota davanti
	end
end)

-- ---------------------------------------------------------------- ciclo

RunService.Heartbeat:Connect(function(dt)
	if guida then
		if guida.moto.Parent ~= cartella then
			fineGuida()
		else
			guidaPasso(dt)
		end
	end
end)

RunService.RenderStepped:Connect(function(dt)
	local inSella = {}
	for _, moto in ipairs(cartella:GetChildren()) do
		if moto:IsA("Model") then
			local st = statoDi(moto)
			if st then
				aggiornaGrafica(moto, st, dt, guida and guida.moto == moto and guida or nil)
				local char = posaPilota(moto, st, dt)
				if char then
					inSella[char] = true
				end
			end
		end
	end
	-- chi non e' piu' in sella torna normale
	for char in pairs(piloti) do
		if not inSella[char] then
			liberaPilota(char)
		end
	end
end)

-- ---------------------------------------------------------------- camera

-- La camera resta quella di Roblox (libera). Se per 1,5 secondi non la giri, torna piano dietro
-- la moto e la segue nelle curve; in piega si inclina un po' insieme alla moto.
local ATTESA_CAMERA = 1.5
local ultimoGiroCamera = -math.huge

local function segnaCamera()
	ultimoGiroCamera = os.clock()
end

UserInputService.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton2 then
		segnaCamera()
	end
end)
UserInputService.InputChanged:Connect(function(input, giaUsato)
	local tipo = input.UserInputType
	if tipo == Enum.UserInputType.MouseMovement then
		if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)
			or UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter then
			segnaCamera()
		end
	elseif tipo == Enum.UserInputType.Touch then
		if not giaUsato then
			segnaCamera()
		end
	elseif input.KeyCode == Enum.KeyCode.Thumbstick2 and input.Position.Magnitude > 0.25 then
		segnaCamera()
	end
end)

RunService:BindToRenderStep("MotoCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local g = guida
	local cam = Workspace.CurrentCamera
	if not (g and cam and cam.CameraType == Enum.CameraType.Custom) then
		return
	end
	local fuoco = cam.Focus.Position
	local cf = cam.CFrame
	local off = cf.Position - fuoco
	local piatto = Vector3.new(off.X, 0, off.Z)
	if piatto.Magnitude < 0.5 then
		return -- prima persona: non tocco niente
	end
	if os.clock() - ultimoGiroCamera > ATTESA_CAMERA and math.abs(g.vel) > 1 then
		-- angolo attuale della camera attorno al pilota e angolo "dietro la moto"
		local angCam = math.atan2(piatto.X, piatto.Z)
		local diff = (g.yaw - angCam + math.pi) % (2 * math.pi) - math.pi
		local giro = diff * (1 - math.exp(-dt * 2.5))
		local nuovaPos = fuoco + CFrame.Angles(0, giro, 0):VectorToWorldSpace(off)
		cf = CFrame.lookAt(nuovaPos, fuoco)
	end
	g.rollioCam = (g.rollioCam or 0) + (g.piega * 0.3 - (g.rollioCam or 0)) * math.min(1, dt * 5)
	cam.CFrame = cf * CFrame.Angles(0, 0, g.rollioCam)
end)

print("[Moto] Client v" .. VERSIONE .. " avviato")
]]></ProtectedString>
		</Properties>
	</Item>
</roblox>
